#!/bin/bash
# ===========================================
# MarkToSkill Agent - Personal Setup Template
# ===========================================
# Copy this to setup-personal.sh and fill in your values
# This allows you to quickly restore your configuration
# Run: ./scripts/setup-personal.sh

set -e

# Colors
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m'

echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo -e "${BLUE}   MarkToSkill Agent - Loading Personal Configuration${NC}"
echo -e "${BLUE}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${NC}"
echo ""

# ============================================
# EDIT THESE VALUES WITH YOUR CONFIGURATION
# ============================================

# Ollama Configuration
OLLAMA_HOST="http://host.docker.internal:11434"
OLLAMA_MODEL="qwen3.5:9b"

# Server Ports
API_PORT="8000"
UI_PORT="3000"

# Log Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL="INFO"

# ============================================
# DO NOT EDIT BELOW THIS LINE
# ============================================

cat > .env << EOF
# ===========================================
# MarkToSkill Agent Configuration
# ===========================================
# Generated by setup-personal.sh on $(date)

# ---- Ollama Configuration ----
OLLAMA_HOST=${OLLAMA_HOST}
OLLAMA_MODEL=${OLLAMA_MODEL}

# ---- Server Configuration ----
API_HOST=0.0.0.0
API_PORT=${API_PORT}
UI_PORT=${UI_PORT}

# ---- Logging ----
LOG_LEVEL=${LOG_LEVEL}
PYTHONUNBUFFERED=1
EOF

echo -e "${GREEN}✓ .env file created from personal configuration${NC}"
echo ""
echo "Configuration:"
echo "  Ollama Host:  ${OLLAMA_HOST}"
echo "  Ollama Model: ${OLLAMA_MODEL}"
echo "  API Port:     ${API_PORT}"
echo "  UI Port:      ${UI_PORT}"
echo ""
